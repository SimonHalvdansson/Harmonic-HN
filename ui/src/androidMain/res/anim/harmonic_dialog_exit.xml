<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="true"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="120" />
    <scale android:fromXScale="1" android:toXScale="0.96"
        android:fromYScale="1" android:toYScale="0.96"
        android:pivotX="50%" android:pivotY="50%" android:duration="120" />
</set>
