<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory
        android:layout="@layout/preference_category"
        app:title="Debug tools">

        <ListPreference
            app:defaultValue="compose"
            app:entries="@array/ui_implementation_entries"
            app:entryValues="@array/ui_implementation_values"
            app:icon="@drawable/ic_code_blocks"
            app:key="pref_settings_implementation"
            app:singleLineTitle="false"
            app:title="Settings"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:icon="@drawable/ic_refresh"
            app:key="pref_always_show_tap_to_refresh"
            app:singleLineTitle="false"
            app:title="Always show tap to refresh" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:icon="@drawable/ic_info"
            app:key="pref_debug_show_llm_summary_info"
            app:singleLineTitle="false"
            app:title="Additional AI summary debug info" />

        <com.simon.harmonichackernews.settings.DebugHnIdPreference
            app:icon="@drawable/ic_open_in_new"
            app:key="pref_debug_open_hn_id"
            app:singleLineTitle="false"
            app:title="Open HN item by ID" />

        <Preference
            app:icon="@drawable/ic_cached"
            app:key="pref_debug_open_without_cache"
            app:singleLineTitle="false"
            app:title="Open without cache" />

    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/preference_category"
        app:title="Sample content">

        <Preference
            app:icon="@drawable/ic_ballot"
            app:key="pref_debug_link_post"
            app:singleLineTitle="false"
            app:title="Link post" />

        <Preference
            app:icon="@drawable/ic_link"
            app:key="pref_debug_reference_links_post"
            app:singleLineTitle="false"
            app:title="Reference links post" />

        <Preference
            app:icon="@drawable/ic_link"
            app:key="pref_debug_youtube_comment"
            app:singleLineTitle="false"
            app:title="YouTube comment" />

        <Preference
            app:icon="@drawable/ic_comment"
            app:key="pref_debug_very_long_comment"
            app:singleLineTitle="false"
            app:title="Very long comment" />

        <Preference
            app:icon="@drawable/ic_comment"
            app:key="pref_debug_poll"
            app:singleLineTitle="false"
            app:title="Poll" />

        <Preference
            app:icon="@drawable/ic_link"
            app:key="pref_debug_internal_hn_link"
            app:singleLineTitle="false"
            app:title="Internal HN link" />

    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/preference_category"
        app:title="Link previews">

        <Preference
            app:icon="@drawable/ic_link_preview_arxiv"
            app:key="pref_debug_link_preview_arxiv"
            app:singleLineTitle="false"
            app:title="arXiv" />

        <Preference
            app:icon="@drawable/ic_link_preview_github"
            app:key="pref_debug_link_preview_github"
            app:singleLineTitle="false"
            app:title="GitHub" />

        <Preference
            app:icon="@drawable/ic_link_preview_gitlab"
            app:key="pref_debug_link_preview_gitlab"
            app:singleLineTitle="false"
            app:title="GitLab" />

        <Preference
            app:icon="@drawable/ic_link_preview_stack_exchange"
            app:key="pref_debug_link_preview_stack_exchange"
            app:singleLineTitle="false"
            app:title="Stack Exchange" />

        <Preference
            app:icon="@drawable/ic_link_preview_wikipedia"
            app:key="pref_debug_link_preview_wikipedia"
            app:singleLineTitle="false"
            app:title="Wikipedia" />

        <Preference
            app:icon="@drawable/ic_link_preview_x"
            app:key="pref_debug_nitter_video"
            app:singleLineTitle="false"
            app:title="Twitter/X" />

    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/preference_category"
        app:title="Dialogs">

        <Preference
            app:icon="@drawable/ic_explore"
            app:key="pref_debug_welcome_dialog"
            app:singleLineTitle="false"
            app:title="Welcome dialog" />

        <Preference
            app:icon="@drawable/ic_history"
            app:key="pref_debug_changelog"
            app:singleLineTitle="false"
            app:title="Changelog" />

        <Preference
            app:icon="@drawable/ic_notifications"
            app:key="pref_debug_notifications"
            app:singleLineTitle="false"
            app:title="Debug notifications" />

    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/preference_category"
        app:title="Environment">

        <Preference
            app:icon="@drawable/ic_deployed_code"
            app:key="pref_debug_app_version"
            app:selectable="true"
            app:singleLineTitle="false"
            app:title="App version" />

        <Preference
            app:icon="@drawable/ic_tag"
            app:key="pref_debug_app_build"
            app:selectable="false"
            app:singleLineTitle="false"
            app:title="App build" />

        <Preference
            app:icon="@drawable/ic_build"
            app:key="pref_debug_build_version"
            app:selectable="false"
            app:singleLineTitle="false"
            app:title="Build version" />

        <Preference
            app:icon="@drawable/ic_android"
            app:key="pref_debug_android_version"
            app:selectable="false"
            app:singleLineTitle="false"
            app:title="Android version" />

    </PreferenceCategory>

</PreferenceScreen>
