<?xml version="1.0" encoding="utf-8"?>
<resources
  xmlns:window="http://schemas.android.com/apk/res-auto">

  <!--
    The split ratios below are replaced at runtime by FoldableSplitInitializer with the ratio
    picked in settings or set by dragging the divider between the panes.
  -->

  <SplitPairRule
    window:splitRatio="0.5"
    window:splitLayoutDirection="locale"
    window:splitMinWidthDp="700"
    window:splitMaxAspectRatioInPortrait="alwaysAllow"
    window:finishPrimaryWithSecondary="adjacent"
    window:finishSecondaryWithPrimary="always"
    window:clearTop="true">
    <SplitPairFilter
      window:primaryActivityName=".MainActivity"
      window:secondaryActivityName=".CommentsActivity"/>
  </SplitPairRule>

  <SplitPlaceholderRule
    window:placeholderActivityName=".SplitPlaceholderActivity"
    window:splitRatio="0.5"
    window:splitLayoutDirection="locale"
    window:splitMinWidthDp="700"
    window:splitMaxAspectRatioInPortrait="alwaysAllow"
    window:stickyPlaceholder="false"
    window:finishPrimaryWithPlaceholder="adjacent">
    <ActivityFilter
      window:activityName=".MainActivity"/>
  </SplitPlaceholderRule>

  <ActivityRule
    window:alwaysExpand="true">
    <ActivityFilter
      window:activityName=".SettingsActivity"/>
  </ActivityRule>

  <ActivityRule
    window:alwaysExpand="true">
    <ActivityFilter
      window:activityName=".AboutActivity"/>
  </ActivityRule>
  <ActivityRule
    window:alwaysExpand="true">
    <ActivityFilter
      window:activityName=".LicensesActivity"/>
  </ActivityRule>
  <ActivityRule
    window:alwaysExpand="true">
    <ActivityFilter
      window:activityName=".DebugActivity"/>
  </ActivityRule>
  <ActivityRule
    window:alwaysExpand="true">
    <ActivityFilter
      window:activityName=".DialogHostActivity"/>
  </ActivityRule>
</resources>
