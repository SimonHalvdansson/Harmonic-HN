<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppThemeBase" parent="Theme.AppCompat.NoActionBar">
        <item name="android:isLightTheme">false</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_harmonic_splash_gather</item>
        <item name="android:windowSplashScreenAnimationDuration">@integer/splash_icon_animation_duration</item>
        <item name="android:windowSplashScreenBackground">@color/splash_screen_background</item>
    </style>

    <style name="AppThemeLightBase" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:isLightTheme">false</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_harmonic_splash_gather</item>
        <item name="android:windowSplashScreenAnimationDuration">@integer/splash_icon_animation_duration</item>
        <item name="android:windowSplashScreenBackground">@color/splash_screen_background</item>
    </style>

    <style name="AppThemeMaterialFixedBase" parent="Theme.AppCompat.NoActionBar">
        <item name="android:isLightTheme">false</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_harmonic_splash_gather</item>
        <item name="android:windowSplashScreenAnimationDuration">@integer/splash_icon_animation_duration</item>
        <item name="android:windowSplashScreenBackground">@color/material_fixed_surface_dark</item>
    </style>

    <style name="AppThemeMaterialFixedLightBase" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:isLightTheme">false</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_harmonic_splash_gather</item>
        <item name="android:windowSplashScreenAnimationDuration">@integer/splash_icon_animation_duration</item>
        <item name="android:windowSplashScreenBackground">@color/material_fixed_surface_light</item>
    </style>

</resources>
