<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/about_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:orientation="vertical"
        android:paddingLeft="@dimen/single_view_side_margin"
        android:paddingTop="20dp"
        android:paddingRight="@dimen/single_view_side_margin"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center_vertical"
                android:layout_marginRight="16dp"
                android:contentDescription="Harmonic app icon"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/about_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/product_sans"
                    android:text="Harmonic"
                    android:textColor="?attr/storyColorNormal"
                    android:textSize="32dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/about_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-4dp"
                    android:fontFamily="@font/product_sans"
                    android:textColor="?attr/storyColorDisabled"
                    android:textStyle="bold"
                    tools:text="Version 1.3.3.7" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fontFamily="@font/product_sans"
            android:paddingTop="24dp"
            android:paddingBottom="16dp"
            android:text="Harmonic for Hacker News is developed by me, Simon Halvdansson, although since 2023 the app is open source.\n\nThe name 'Harmonic' comes from me choosing to study harmonic analysis at around the time of Harmonic's inception. I guess you could say something about 'waves' and 'news' but that's the rationale. Since then, I've finished my PhD in harmonic analysis and don't have the same amount of time to work on Harmonic but it's still my favorite pet project and I use the app daily. Seeing others contribute, open meaningful issues on GitHub or just tell me they like the app is always super nice and I'm very thankful to the community for helping with the maintenance. Together I think we can keep Harmonic the (in my opinion) best Hacker News client for Android!"
            android:textSize="16sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSecondaryContainer"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/about_feedback_github_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_link_preview_github"
                    app:tint="?attr/colorOnSecondaryContainer" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/product_sans_bold"
                        android:text="Have feedback?"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/product_sans"
                        android:text="Please submit it by opening an issue or starting a discussion on Harmonic’s GitHub page"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/about_github"
            style="@style/Widget.Material3Expressive.Button.IconButton.Outlined"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/product_sans_bold"
            android:text="Harmonic on GitHub"
            android:textColor="?attr/storyColorNormal"
            android:textSize="14sp"
            app:icon="@drawable/ic_link_preview_github"
            app:iconTint="?attr/storyColorNormal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/about_changelog"
            style="@style/Widget.Material3Expressive.Button.IconButton.Outlined"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:fontFamily="@font/product_sans_bold"
            android:text="Changelog"
            android:textColor="?attr/storyColorNormal"
            android:textSize="14sp"
            app:icon="@drawable/ic_system_update_alt"
            app:iconTint="?attr/storyColorNormal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/about_licenses"
            style="@style/Widget.Material3Expressive.Button.IconButton.Outlined"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:fontFamily="@font/product_sans_bold"
            android:text="Licenses"
            android:textColor="?attr/storyColorNormal"
            android:textSize="14sp"
            app:icon="@drawable/ic_attribution"
            app:iconTint="?attr/storyColorNormal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/about_privacy"
            style="@style/Widget.Material3Expressive.Button.IconButton.Outlined"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:fontFamily="@font/product_sans_bold"
            android:text="Privacy policy"
            android:textColor="?attr/storyColorNormal"
            android:textSize="14sp"
            app:icon="@drawable/ic_policy"
            app:iconTint="?attr/storyColorNormal" />

    </LinearLayout>

</ScrollView>
