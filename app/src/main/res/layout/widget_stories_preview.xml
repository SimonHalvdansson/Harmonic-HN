<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher picker RemoteViews use platform tint, not AppCompat app:tint. -->
<!-- Match the medium image layout in StoriesGlanceWidget and WidgetDimensions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_background"
    android:clipToOutline="true" tools:ignore="HardcodedText,UseAppTint">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="4dp"
        android:paddingTop="6dp" android:paddingBottom="2dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/widget_top_stories" android:fontFamily="variable-body-medium-emphasized" android:textStyle="bold"
            android:textSize="18sp" android:textColor="@color/widget_title" android:maxLines="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Updated just now" android:fontFamily="variable-body-medium-emphasized" android:textSize="11sp"
            android:textColor="@color/widget_secondary_text" />
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp"
            android:src="@drawable/ic_refresh_widget" android:contentDescription="@string/widget_refresh_content_description" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp" android:layout_marginBottom="7dp"
        android:minHeight="88dp" android:paddingStart="8dp" android:gravity="center_vertical" android:orientation="horizontal"
        android:background="@drawable/widget_preview_card">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:paddingVertical="12dp" android:orientation="horizontal" android:baselineAligned="true">
            <TextView android:layout_width="20dp" android:layout_height="wrap_content"
                android:text="1." android:textSize="12sp" android:fontFamily="variable-body-medium-emphasized" android:textColor="@color/widget_secondary_text" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:baselineAlignedChildIndex="0" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Algorithm breaks speed limit for solving linear equations" android:fontFamily="variable-body-medium-emphasized" android:textStyle="bold"
                    android:textSize="14sp" android:textColor="@color/widget_story_title" android:maxLines="4" android:ellipsize="end" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="science.org · 2h" android:fontFamily="variable-body-medium-emphasized" android:textSize="11sp"
                    android:textColor="@color/widget_story_meta" android:maxLines="2" />
            </LinearLayout>
        </LinearLayout>
        <FrameLayout android:layout_width="120dp" android:layout_height="72dp"
            android:layout_marginStart="6dp" android:layout_marginEnd="8dp" android:layout_marginVertical="8dp"
            android:background="@drawable/widget_preview_image" android:clipToOutline="true">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/widget_preview_equations" android:scaleType="centerCrop" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="bottom|end" android:layout_margin="4dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/widget_preview_metric"
                    android:paddingStart="2dp" android:paddingEnd="7dp" android:paddingVertical="4dp">
                    <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_arrow_drop_up"
                        android:tint="@color/widget_story_title" android:importantForAccessibility="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="53"
                        android:fontFamily="variable-body-medium-emphasized" android:textSize="12sp" android:textStyle="bold"
                        android:textColor="@color/widget_story_title" android:maxLines="1" />
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/widget_preview_metric"
                    android:paddingStart="5dp" android:paddingEnd="7dp" android:paddingVertical="4dp">
                    <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_comment"
                        android:tint="@color/widget_story_title" android:importantForAccessibility="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="18" android:layout_marginStart="2dp"
                        android:fontFamily="variable-body-medium-emphasized" android:textSize="12sp" android:textStyle="bold"
                        android:textColor="@color/widget_story_title" android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp" android:layout_marginBottom="7dp"
        android:minHeight="88dp" android:paddingStart="8dp" android:gravity="center_vertical" android:orientation="horizontal"
        android:background="@drawable/widget_preview_card">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:paddingVertical="12dp" android:orientation="horizontal" android:baselineAligned="true">
            <TextView android:layout_width="20dp" android:layout_height="wrap_content"
                android:text="2." android:textSize="12sp" android:fontFamily="variable-body-medium-emphasized" android:textColor="@color/widget_secondary_text" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:baselineAlignedChildIndex="0" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="The hidden gardens of New York City" android:fontFamily="variable-body-medium-emphasized" android:textStyle="bold"
                    android:textSize="14sp" android:textColor="@color/widget_story_title" android:maxLines="4" android:ellipsize="end" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="nytimes.com · 4h" android:fontFamily="variable-body-medium-emphasized" android:textSize="11sp"
                    android:textColor="@color/widget_story_meta" android:maxLines="2" />
            </LinearLayout>
        </LinearLayout>
        <FrameLayout android:layout_width="120dp" android:layout_height="72dp"
            android:layout_marginStart="6dp" android:layout_marginEnd="8dp" android:layout_marginVertical="8dp"
            android:background="@drawable/widget_preview_image" android:clipToOutline="true">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/widget_preview_gardens" android:scaleType="centerCrop" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="bottom|end" android:layout_margin="4dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/widget_preview_metric"
                    android:paddingStart="2dp" android:paddingEnd="7dp" android:paddingVertical="4dp">
                    <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_arrow_drop_up"
                        android:tint="@color/widget_story_title" android:importantForAccessibility="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="128"
                        android:fontFamily="variable-body-medium-emphasized" android:textSize="12sp" android:textStyle="bold"
                        android:textColor="@color/widget_story_title" android:maxLines="1" />
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/widget_preview_metric"
                    android:paddingStart="5dp" android:paddingEnd="7dp" android:paddingVertical="4dp">
                    <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_comment"
                        android:tint="@color/widget_story_title" android:importantForAccessibility="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="42" android:layout_marginStart="2dp"
                        android:fontFamily="variable-body-medium-emphasized" android:textSize="12sp" android:textStyle="bold"
                        android:textColor="@color/widget_story_title" android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp" android:layout_marginBottom="7dp"
        android:minHeight="88dp" android:paddingStart="8dp" android:gravity="center_vertical" android:orientation="horizontal"
        android:background="@drawable/widget_preview_card">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:paddingVertical="12dp" android:orientation="horizontal" android:baselineAligned="true">
            <TextView android:layout_width="20dp" android:layout_height="wrap_content"
                android:text="3." android:textSize="12sp" android:fontFamily="variable-body-medium-emphasized" android:textColor="@color/widget_secondary_text" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:baselineAlignedChildIndex="0" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Finding new patterns in old mathematics" android:fontFamily="variable-body-medium-emphasized" android:textStyle="bold"
                    android:textSize="14sp" android:textColor="@color/widget_story_title" android:maxLines="4" android:ellipsize="end" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="science.org · 5h" android:fontFamily="variable-body-medium-emphasized" android:textSize="11sp"
                    android:textColor="@color/widget_story_meta" android:maxLines="2" />
            </LinearLayout>
        </LinearLayout>
        <FrameLayout android:layout_width="120dp" android:layout_height="72dp"
            android:layout_marginStart="6dp" android:layout_marginEnd="8dp" android:layout_marginVertical="8dp"
            android:background="@drawable/widget_preview_image" android:clipToOutline="true">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/widget_preview_equations" android:scaleType="centerCrop" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="bottom|end" android:layout_margin="4dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/widget_preview_metric"
                    android:paddingStart="2dp" android:paddingEnd="7dp" android:paddingVertical="4dp">
                    <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_arrow_drop_up"
                        android:tint="@color/widget_story_title" android:importantForAccessibility="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="91"
                        android:fontFamily="variable-body-medium-emphasized" android:textSize="12sp" android:textStyle="bold"
                        android:textColor="@color/widget_story_title" android:maxLines="1" />
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/widget_preview_metric"
                    android:paddingStart="5dp" android:paddingEnd="7dp" android:paddingVertical="4dp">
                    <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_comment"
                        android:tint="@color/widget_story_title" android:importantForAccessibility="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="24" android:layout_marginStart="2dp"
                        android:fontFamily="variable-body-medium-emphasized" android:textSize="12sp" android:textStyle="bold"
                        android:textColor="@color/widget_story_title" android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp" android:layout_marginBottom="7dp"
        android:minHeight="88dp" android:paddingStart="8dp" android:gravity="center_vertical" android:orientation="horizontal"
        android:background="@drawable/widget_preview_card">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:paddingVertical="12dp" android:orientation="horizontal" android:baselineAligned="true">
            <TextView android:layout_width="20dp" android:layout_height="wrap_content"
                android:text="4." android:textSize="12sp" android:fontFamily="variable-body-medium-emphasized" android:textColor="@color/widget_secondary_text" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:baselineAlignedChildIndex="0" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="A quieter corner of the city" android:fontFamily="variable-body-medium-emphasized" android:textStyle="bold"
                    android:textSize="14sp" android:textColor="@color/widget_story_title" android:maxLines="4" android:ellipsize="end" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="nytimes.com · 6h" android:fontFamily="variable-body-medium-emphasized" android:textSize="11sp"
                    android:textColor="@color/widget_story_meta" android:maxLines="2" />
            </LinearLayout>
        </LinearLayout>
        <FrameLayout android:layout_width="120dp" android:layout_height="72dp"
            android:layout_marginStart="6dp" android:layout_marginEnd="8dp" android:layout_marginVertical="8dp"
            android:background="@drawable/widget_preview_image" android:clipToOutline="true">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/widget_preview_gardens" android:scaleType="centerCrop" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="bottom|end" android:layout_margin="4dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/widget_preview_metric"
                    android:paddingStart="2dp" android:paddingEnd="7dp" android:paddingVertical="4dp">
                    <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_arrow_drop_up"
                        android:tint="@color/widget_story_title" android:importantForAccessibility="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="76"
                        android:fontFamily="variable-body-medium-emphasized" android:textSize="12sp" android:textStyle="bold"
                        android:textColor="@color/widget_story_title" android:maxLines="1" />
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/widget_preview_metric"
                    android:paddingStart="5dp" android:paddingEnd="7dp" android:paddingVertical="4dp">
                    <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_comment"
                        android:tint="@color/widget_story_title" android:importantForAccessibility="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="57" android:layout_marginStart="2dp"
                        android:fontFamily="variable-body-medium-emphasized" android:textSize="12sp" android:textStyle="bold"
                        android:textColor="@color/widget_story_title" android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
