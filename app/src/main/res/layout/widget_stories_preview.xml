<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher picker RemoteViews use platform tint, not AppCompat app:tint. -->
<!-- The live widget is rendered by StoriesGlanceWidget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_background"
    android:clipToOutline="true" tools:ignore="HardcodedText,UseAppTint">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="4dp"
        android:paddingTop="6dp" android:paddingBottom="2dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/widget_top_stories" android:fontFamily="variable-body-medium-emphasized" android:textStyle="bold"
            android:textSize="18sp" android:textColor="@color/widget_title" android:maxLines="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Updated just now" android:fontFamily="variable-body-medium-emphasized" android:textSize="11sp"
            android:textColor="@color/widget_secondary_text" />
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp"
            android:src="@drawable/ic_refresh_widget" android:contentDescription="@string/widget_refresh_content_description" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp" android:layout_marginBottom="7dp"
        android:paddingStart="8dp" android:gravity="center_vertical" android:orientation="horizontal"
        android:background="@drawable/widget_preview_card">
        <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:layout_gravity="top" android:layout_marginTop="12dp"
            android:text="1." android:textSize="13sp" android:fontFamily="variable-body-medium-emphasized" android:textColor="@color/widget_secondary_text" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:paddingVertical="12dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Algorithm breaks speed limit for solving linear equations" android:fontFamily="variable-body-medium-emphasized" android:textStyle="bold"
                android:textSize="14sp" android:textColor="@color/widget_story_title" android:maxLines="3" android:ellipsize="end" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="53 points · science.org · 2h" android:fontFamily="variable-body-medium-emphasized" android:textSize="11sp"
                android:textColor="@color/widget_story_meta" android:maxLines="2" />
        </LinearLayout>
        <ImageView android:layout_width="72dp" android:layout_height="52dp" android:layout_marginStart="6dp"
            android:background="@drawable/widget_preview_card" android:clipToOutline="true"
            android:src="@drawable/widget_preview_equations" android:scaleType="centerCrop" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="48dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_comment"
                android:tint="@color/widget_story_title" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="18"
                android:fontFamily="variable-body-medium-emphasized" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_story_title" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp" android:layout_marginBottom="7dp"
        android:paddingStart="8dp" android:gravity="center_vertical" android:orientation="horizontal"
        android:background="@drawable/widget_preview_card">
        <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:layout_gravity="top" android:layout_marginTop="12dp"
            android:text="2." android:textSize="13sp" android:fontFamily="variable-body-medium-emphasized" android:textColor="@color/widget_secondary_text" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:paddingVertical="12dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="The hidden gardens of New York City" android:fontFamily="variable-body-medium-emphasized" android:textStyle="bold"
                android:textSize="14sp" android:textColor="@color/widget_story_title" android:maxLines="3" android:ellipsize="end" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="128 points · nytimes.com · 4h" android:fontFamily="variable-body-medium-emphasized" android:textSize="11sp"
                android:textColor="@color/widget_story_meta" android:maxLines="2" />
        </LinearLayout>
        <ImageView android:layout_width="72dp" android:layout_height="52dp" android:layout_marginStart="6dp"
            android:background="@drawable/widget_preview_card" android:clipToOutline="true"
            android:src="@drawable/widget_preview_gardens" android:scaleType="centerCrop" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="48dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_comment"
                android:tint="@color/widget_story_title" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="42"
                android:fontFamily="variable-body-medium-emphasized" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_story_title" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp" android:layout_marginBottom="7dp"
        android:paddingStart="8dp" android:gravity="center_vertical" android:orientation="horizontal"
        android:background="@drawable/widget_preview_card">
        <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:layout_gravity="top" android:layout_marginTop="12dp"
            android:text="3." android:textSize="13sp" android:fontFamily="variable-body-medium-emphasized" android:textColor="@color/widget_secondary_text" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:paddingVertical="12dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Finding new patterns in old mathematics" android:fontFamily="variable-body-medium-emphasized" android:textStyle="bold"
                android:textSize="14sp" android:textColor="@color/widget_story_title" android:maxLines="3" android:ellipsize="end" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="91 points · science.org · 5h" android:fontFamily="variable-body-medium-emphasized" android:textSize="11sp"
                android:textColor="@color/widget_story_meta" android:maxLines="2" />
        </LinearLayout>
        <ImageView android:layout_width="72dp" android:layout_height="52dp" android:layout_marginStart="6dp"
            android:background="@drawable/widget_preview_card" android:clipToOutline="true"
            android:src="@drawable/widget_preview_equations" android:scaleType="centerCrop" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="48dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_comment"
                android:tint="@color/widget_story_title" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="24"
                android:fontFamily="variable-body-medium-emphasized" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_story_title" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp" android:layout_marginBottom="7dp"
        android:paddingStart="8dp" android:gravity="center_vertical" android:orientation="horizontal"
        android:background="@drawable/widget_preview_card">
        <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:layout_gravity="top" android:layout_marginTop="12dp"
            android:text="4." android:textSize="13sp" android:fontFamily="variable-body-medium-emphasized" android:textColor="@color/widget_secondary_text" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:paddingVertical="12dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="A quieter corner of the city" android:fontFamily="variable-body-medium-emphasized" android:textStyle="bold"
                android:textSize="14sp" android:textColor="@color/widget_story_title" android:maxLines="3" android:ellipsize="end" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="76 points · nytimes.com · 6h" android:fontFamily="variable-body-medium-emphasized" android:textSize="11sp"
                android:textColor="@color/widget_story_meta" android:maxLines="2" />
        </LinearLayout>
        <ImageView android:layout_width="72dp" android:layout_height="52dp" android:layout_marginStart="6dp"
            android:background="@drawable/widget_preview_card" android:clipToOutline="true"
            android:src="@drawable/widget_preview_gardens" android:scaleType="centerCrop" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="48dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_comment"
                android:tint="@color/widget_story_title" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="57"
                android:fontFamily="variable-body-medium-emphasized" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_story_title" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
